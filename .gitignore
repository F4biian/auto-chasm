# Keeps the working directory self-contained and prevents accidental commits of
# large model artifacts, caches, and run outputs.

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.python-version

# --- Build artifacts ---
dist/
build/

# --- Virtualenv / tooling caches ---
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Secrets / environment ---
.env

# --- OS noise ---
.DS_Store

# --- Run outputs & model artifacts ---
# Training and inference outputs in the repository root (the Trainer writes to
# ./checkpoints by default). Anchored with "/" so tests/unit/checkpoints/ is tracked.
/runs/
/checkpoints/
/ckpt/
my_model/
steering_data/
demo/demo_digit_output/

# Local Claude Code state (worktrees, settings)
.claude/
